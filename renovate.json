{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests"
  ],
  "timezone": "Europe/Berlin",
  "schedule": [
    "* 0-5 * * 1"
  ],
  "prConcurrentLimit": 5,
  "minimumReleaseAge": "10 days",
  "labels": [
    "dependencies"
  ],
  "packageRules": [
    {
      "description": "Development dependencies: the dev groups of the Python projects, the web UI's devDependencies",
      "matchDepTypes": [
        "devDependencies",
        "dependency-groups"
      ],
      "labels": [
        "dev-deps"
      ]
    },
    {
      "description": "The devcontainer: its features and the services of its compose file",
      "matchFileNames": [
        ".devcontainer/**"
      ],
      "labels": [
        "dev-deps"
      ]
    },
    {
      "description": "The actions of the workflows, pinned to their commits",
      "matchManagers": [
        "github-actions"
      ],
      "labels": [
        "ci"
      ]
    },
    {
      "description": "Lekto's own images, which the compose examples name",
      "matchPackageNames": [
        "ghcr.io/lektohq/**"
      ],
      "enabled": false
    },
    {
      "description": "Claude Code of the dev container",
      "matchPackageNames": [
        "@anthropic-ai/claude-code"
      ],
      "labels": [
        "dev-deps"
      ]
    }
  ],
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": [
      "* 0-5 1 * *"
    ]
  },
  "customManagers": [
    {
      "description": "Claude Code in the dev stage of the Dockerfile: the version after the `# renovate:` comment",
      "customType": "regex",
      "managerFilePatterns": [
        "/(^|/)Dockerfile$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\nARG [A-Z_]+_VERSION=(?<currentValue>\\S+)"
      ]
    }
  ]
}
