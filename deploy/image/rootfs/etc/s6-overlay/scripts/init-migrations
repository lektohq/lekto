#!/command/with-contenv sh
# The database schema must be right before API and worker start. `all` and `api` migrate here.
# A `worker` never migrates; svc-worker waits for the schema itself (a oneshot cannot be stopped
# by `docker stop`, a service can).
set -eu

# LEKTO_ROLE as init-lekto resolved it.
if [ "$LEKTO_ROLE" = worker ]; then
  echo "init-migrations: LEKTO_ROLE=worker does not migrate; svc-worker waits for the schema"
  exit 0
fi
exec lekto-run lekto migrate
