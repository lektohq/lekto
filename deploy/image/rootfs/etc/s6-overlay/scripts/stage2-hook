#!/command/with-contenv sh
# S6_STAGE2_HOOK: runs before s6-rc compiles and starts the services. Writes the bundle `user` for
# LEKTO_ROLE to S6_RUNTIME_BUNDLEDIR (/run, so that /etc stays as built): a service the role does
# not run is not in it, and s6 never starts it. Started only to stop at once, it raced s6-rc's wait
# for it ("s6-ftrigrd: fatal: unable to flush asyncout: Broken pipe" in the log). An unknown role
# keeps every service; init-lekto refuses it.
set -eu
source=/etc/s6-overlay/user-bundles.d
target=$(printenv S6_RUNTIME_BUNDLEDIR)
role=$(printf %s "${LEKTO_ROLE:-all}" | tr '[:upper:]' '[:lower:]')

rm -rf "$target"
mkdir -p "$target"
cp -R "$source/." "$target/"
case "$role" in
  api) left=svc-worker ;;
  worker) left=svc-api ;;
  *) left= ;;
esac
if [ -n "$left" ]; then
  rm -f "$target/user/contents.d/$left"
  echo "stage2-hook: $left is not started with LEKTO_ROLE=$role"
fi
