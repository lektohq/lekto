{
	"name": "lekto-web",
	"version": "0.0.0-dev.0",
	"private": true,
	"type": "module",
	"imports": {
		"#lib": "./src/lib",
		"#lib/*": "./src/lib/*"
	},
	"packageManager": "pnpm@12.9.1",
	"engines": {
		"node": ">=24.21.0"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "pnpm paraglide && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings && tsc -p src/service-worker",
		"lint": "eslint --cache --cache-strategy content --cache-location node_modules/.cache/eslint/ .",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"test": "vitest run",
		"gen:api": "openapi-typescript openapi.json -o src/lib/api/schema.ts && prettier --write src/lib/api/schema.ts",
		"e2e": "playwright test",
		"paraglide": "paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide --strategy localStorage preferredLanguage baseLocale"
	},
	"devDependencies": {
		"@eslint/js": "10.0.1",
		"@fontsource-variable/geist": "5.3.0",
		"@fontsource-variable/geist-mono": "5.3.0",
		"@inlang/paraglide-js": "2.29.3",
		"@inlang/plugin-message-format": "4.6.0",
		"@internationalized/date": "3.12.4",
		"@lucide/svelte": "1.72.0",
		"@playwright/test": "1.65.0",
		"@sveltejs/adapter-static": "4.0.1",
		"@sveltejs/kit": "3.2.0",
		"@sveltejs/vite-plugin-svelte": "7.3.1",
		"@tailwindcss/vite": "4.3.5",
		"@testing-library/svelte": "5.4.2",
		"@testing-library/user-event": "14.6.10",
		"bits-ui": "2.21.0",
		"clsx": "2.1.1",
		"eslint": "10.14.0",
		"eslint-config-prettier": "10.1.8",
		"eslint-plugin-svelte": "3.24.1",
		"globals": "17.14.0",
		"jsdom": "30.1.3",
		"layerchart": "2.10.0",
		"mode-watcher": "1.1.0",
		"openapi-fetch": "0.17.0",
		"openapi-typescript": "7.13.0",
		"prettier": "3.10.1",
		"prettier-plugin-svelte": "4.1.1",
		"prettier-plugin-tailwindcss": "0.8.1",
		"svelte": "5.57.3",
		"svelte-check": "4.7.8",
		"svelte-sonner": "1.2.3",
		"swagger-ui-dist": "5.34.1",
		"tailwind-merge": "3.7.0",
		"tailwind-variants": "3.3.1",
		"tailwindcss": "4.3.5",
		"tw-animate-css": "1.4.0",
		"typescript": "6.0.3",
		"typescript-eslint": "8.72.2",
		"vite": "8.3.8",
		"vitest": "5.1.0"
	},
	"dependencies": {
		"@codemirror/autocomplete": "6.20.3",
		"@codemirror/commands": "6.11.1",
		"@codemirror/state": "6.7.6",
		"@codemirror/view": "6.43.13",
		"pdfjs-dist": "6.4.299",
		"uqr": "0.1.3"
	}
}
